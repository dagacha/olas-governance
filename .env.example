# Copy to .env and replace every placeholder. Never commit .env.
# At least one RPC setting is recommended. Public RPC fallbacks are used if none is set.

# Required to fetch the GovernorOLAS contract ABI from Etherscan.
ETHERSCAN_API_KEY=replace-with-etherscan-api-key

# Optional authenticated Ethereum mainnet RPC. Prefer one of these over public fallbacks.
# ALCHEMY_API_KEY=replace-with-alchemy-api-key
# ETH_RPC_URL=https://your-rpc-provider.example/v1/replace-with-api-key

# Required for Telegram alerts and the /governance command poller.
TELEGRAM_TOKEN=replace-with-telegram-bot-token
CHAT_ID=replace-with-authorized-telegram-chat-id

